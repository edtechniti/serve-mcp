# Copy to .env (gitignored) or set in your MCP client config. Never commit real values.

# mock (default, no credentials) | sandbox | production
SERVE_ENV=mock

# Optional override, e.g. to run the mock on another port
# SERVE_BASE_URL=http://127.0.0.1:4010

# Required for sandbox and production (from the Serve developer portal)
# SERVE_PARTNER_ID=
# SERVE_API_KEY=

# Production dispatches real robots and incurs real fees. Both switches are required.
# SERVE_ALLOW_PRODUCTION=false

# Hard cap on any single delivery fee, in cents
SERVE_MAX_FEE_CENTS=1500

# nominatim (OpenStreetMap) | none (callers must pass lat/lng)
GEOCODER=nominatim
# Nominatim's usage policy asks for an identifying User-Agent with contact info
# GEOCODER_USER_AGENT=serve-delivery-mcp (you@example.com)

LOG_LEVEL=info
