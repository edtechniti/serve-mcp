{
  "name": "serve-delivery-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI assistants quote, dispatch and track sidewalk delivery robots via the Serve Robotics AV Delivery API. Independent project; not affiliated with Serve Robotics.",
  "license": "MIT",
  "author": "edTechniti",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "serve-delivery-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "dist/mock",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "mock": "tsx mock/main.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "robotics",
    "delivery",
    "ai-agents"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
